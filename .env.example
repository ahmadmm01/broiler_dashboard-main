# The production-safe default. Netlify will keep using dummy videos when this
# variable is not set or has any value other than "rtsp".
VIDEO_SOURCE_MODE=dummy

# Use one shared camera for every zone, or leave this empty and configure the
# zone-specific URLs below. Never commit real usernames or passwords.
RTSP_URL=
RTSP_URL_A=
RTSP_URL_B=
RTSP_URL_C=

# Local FFmpeg and stream tuning.
FFMPEG_PATH=ffmpeg
RTSP_TRANSPORT=tcp
RTSP_FPS=10
RTSP_MAX_WIDTH=1280
RTSP_JPEG_QUALITY=5
RTSP_IDLE_TIMEOUT_MS=5000

# Sensor replay cadence for the audit/demo dashboard. One new simulated sensor
# reading is appended every minute to match the one-minute replay dataset.
NEXT_PUBLIC_SENSOR_REPLAY_INTERVAL_MS=60000

# Comma-separated dashboard zones. Use A for an audit-focused single-house
# view, or A,B,C to restore the multi-zone presentation.
NEXT_PUBLIC_ACTIVE_ZONES=A,B,C

# Server-side OpenAI configuration for AI summary and current-cycle
# recommendations. Never use a NEXT_PUBLIC_ prefix for the API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
